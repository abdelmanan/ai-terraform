# Modèle de .env. En local : copier en .env à la racine du dépôt.
# En production : à déposer sur l'instance EC2 dans /opt/ai-tf-landing-zone/.env
# (lu par `docker compose --env-file .env` au déploiement). Ne jamais le versionner.

# --- Requis -----------------------------------------------------------------
GROQ_API_KEY=gsk_...

# --- Production -------------------------------------------------------------
# Bucket des archives générées. Vide = archives servies depuis le disque local.
S3_BUCKET=
S3_PREFIX=generated
AWS_REGION=eu-west-3

# Origine publique du site (http://<IP ou domaine>). nginx sert /api sur la même
# origine, le CORS ne sert qu'aux appels directs au backend.
CORS_ORIGINS=http://localhost:5173

# Authentification basique devant tout le site (hors /health).
# À DÉFINIR dès que l'instance est publique.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- Optionnels -------------------------------------------------------------
LOG_LEVEL=INFO
# Générations simultanées avant de répondre 429 (chacune lance terraform init).
MAX_CONCURRENT_GENERATIONS=2
# Durée de vie des générations sur le disque local, en secondes.
GENERATION_TTL_SECONDS=86400
